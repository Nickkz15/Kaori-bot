TOKEN=
GUILD_ID=
ROLE_ID=
GEMINI_API_KEY=
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true

# Optional: override Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional: max output tokens for AI replies (default: 100)
# MAX_OUTPUT_TOKENS=100

# Optional: retries for transient Gemini failures (default: 1)
# MAX_AI_RETRIES=1

# Optional: request timeout in ms (default: 25000)
# AI_REQUEST_TIMEOUT_MS=25000

# Optional secondary provider — xAI / Grok (bot works without these)
# XAI_API_KEY=
# XAI_MODEL=grok-3-mini
